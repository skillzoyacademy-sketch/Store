    </footer>

    <script>
        // بيانات قائمة الطعام
        const menuItems = [
            {
                id: 1,
                name: "حمص بالطحينة",
                description: "حمص مع طحينة وزيت زيتون وتوابل خاصة",
                price: "15 ريال",
                category: "appetizers",
                image: "https://images.unsplash.com/photo-1525648199074-cee30ba54a4e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80"
            },
            {
                id: 2,
                name: "تبولة",
                description: "سلطة تبولة طازجة مع البقدونس والبرغل",
                price: "18 ريال",
                category: "appetizers",
                image: "https://images.unsplash.com/photo-1592417817098-8fd3d9eb14a5?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80"
            },
            {
                id: 3,
                name: "كبة مقلية",
                description: "كبة محشية باللحم والصنوبر ومقلية بالقلي العميق",
                price: "35 ريال",
                category: "appetizers",
                image: "https://images.unsplash.com/photo-1608039829572-3fd13b9d9c42?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80"
            },
            {
                id: 4,
                name: "مندي لحم",
                description: "لحم ضأن مطهو على البخار مع الأرز البسمتي والتوابل",
                price: "75 ريال",
                category: "main",
                image: "https://images.unsplash.com/photo-1605296830714-7c02e14957ac?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80"
            },
            {
                id: 5,
                name: "كبسة دجاج",
                description: "أرز كبسة مع دجاج وتوابل خاصة ومكسرات",
                price: "65 ريال",
                category: "main",
                image: "https://images.unsplash.com/photo-1546833999-b9f581a1996d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80"
            },
            {
                id: 6,
                name: "سمك مشوي",
                description: "سمك ناجل طازج مشوي على الفحم مع صلصة ليمون",
                price: "85 ريال",
                category: "main",
                image: "https://images.unsplash.com/photo-1606472976755-8949d6d2b0f3?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80"
            },
            {
                id: 7,
                name: "كنافة بالنوتيلا",
                description: "كنافة محشية بالنوتيلا ومغطاة بالفستق الحلبي",
                price: "30 ريال",
                category: "desserts",
                image: "https://images.unsplash.com/photo-1563729784474-d77dbb933a9e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=687&q=80"
            },
            {
                id: 8,
                name: "أم علي",
                description: "حلى أم علي التقليدي مع القشطة والمكسرات",
                price: "25 ريال",
                category: "desserts",
                image: "https://images.unsplash.com/photo-1565958011703-44f9829ba187?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=765&q=80"
            },
            {
                id: 9,
                name: "عصير فراولة طازج",
                description: "عصير فراولة طازج بدون إضافات صناعية",
                price: "18 ريال",
                category: "drinks",
                image: "https://images.unsplash.com/photo-1621506289937-a8e4df240d0b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=687&q=80"
            },
            {
                id: 10,
                name: "قهوة عربية",
                description: "قهوة عربية أصيلة مع هيل",
                price: "12 ريال",
                category: "drinks",
                image: "https://images.unsplash.com/photo-1511537190424-bbbab87ac5eb?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80"
            }
        ];

        // DOM جاهز
        document.addEventListener('DOMContentLoaded', function() {
            // القائمة المتنقلة
            const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
            const navLinks = document.querySelector('.nav-links');
            
            mobileMenuBtn.addEventListener('click', function() {
                navLinks.classList.toggle('active');
                mobileMenuBtn.innerHTML = navLinks.classList.contains('active') 
                    ? '<i class="fas fa-times"></i>' 
                    : '<i class="fas fa-bars"></i>';
            });
            
            // إغلاق القائمة عند النقر على رابط
            document.querySelectorAll('.nav-links a').forEach(link => {
                link.addEventListener('click', () => {
                    navLinks.classList.remove('active');
                    mobileMenuBtn.innerHTML = '<i class="fas fa-bars"></i>';
                });
            });
            
            // تحميل عناصر القائمة
            const menuContainer = document.querySelector('.menu-container');
            const filterBtns = document.querySelectorAll('.filter-btn');
            
            function loadMenuItems(filter = 'all') {
                menuContainer.innerHTML = '';
                
                const filteredItems = filter === 'all' 
                    ? menuItems 
                    : menuItems.filter(item => item.category === filter);
                
                filteredItems.forEach(item => {
                    const menuItemElement = document.createElement('div');
                    menuItemElement.className = 'menu-item';
                    menuItemElement.setAttribute('data-category', item.category);
                    
                    menuItemElement.innerHTML = `
                        <img src="${item.image}" alt="${item.name}" class="menu-item-img">
                        <div class="menu-item-content">
                            <div class="menu-item-header">
                                <h3 class="menu-item-title">${item.name}</h3>
                                <span class="menu-item-price">${item.price}</span>
                            </div>
                            <span class="menu-item-category">${getCategoryName(item.category)}</span>
                            <p>${item.description}</p>
                        </div>
                    `;
                    
                    menuContainer.appendChild(menuItemElement);
                });
            }
            
            // أسماء الفئات
            function getCategoryName(category) {
                const categories = {
                    'appetizers': 'مقبلات',
                    'main': 'أطباق رئيسية',
                    'desserts': 'حلويات',
                    'drinks': 'مشروبات'
                };
                return categories[category] || category;
            }
            
            // تصفية القائمة
            filterBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    // إزالة النشط من جميع الأزرار
                    filterBtns.forEach(b => b.classList.remove('active'));
                    // إضافة النشط للزر المضغوط
                    this.classList.add('active');
                    
                    // تحميل العناصر المفلترة
                    const filter = this.getAttribute('data-filter');
                    loadMenuItems(filter);
                });
            });
            
            // تحميل جميع العناصر افتراضيًا
            loadMenuItems();
            
            // نموذج الحجز
            const reservationForm = document.getElementById('reservationForm');
            reservationForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const name = document.getElementById('name').value;
                const date = document.getElementById('date').value;
                
                if (name && date) {
                    alert(`شكراً ${name}! تم استلام حجزك بتاريخ ${date}. سنتواصل معك قريباً للتأكيد.`);
                    reservationForm.reset();
                    
                    // تعيين الحد الأدنى للتاريخ على اليوم الحالي
                    const today = new Date().toISOString().split('T')[0];
                    document.getElementById('date').min = today;
                }
            });
            
            // تعيين الحد الأدنى للتاريخ على اليوم الحالي
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('date').min = today;
            
            // تأثير التمرير السلس
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const targetId = this.getAttribute('href');
                    if (targetId === '#') return;
                    
                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        window.scrollTo({
                            top: targetElement.offsetTop - 70,
                            behavior: 'smooth'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>
